/**
 * @fileoverview Firestore Security Rules for the SwimWise application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles, competition times, workouts, and workout items.
 * Only the authenticated user can create, read, update, or delete their own data.
 * Events are considered public and accessible to all users.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information. 'userId' must match the Firebase Auth UID.
 * - /users/{userId}/competitionTimes/{competitionTimeId}: Stores competition times for each user.
 * - /users/{userId}/workouts/{workoutId}: Stores workouts created by each user.
 * - /users/{userId}/workouts/{workoutId}/workoutItems/{workoutItemId}: Stores workout items for each workout.
 * - /events/{eventId}: Stores global event data.
 *
 * Key Security Decisions:
 * - User profiles are private and only accessible to the authenticated user.
 * - Events are public and accessible to all users.
 * - All list operations are secured based on ownership.
 * - Data consistency between path and document fields is enforced on creation and updates.
 *
 * Denormalization for Authorization:
 * - The `userProfileId` field is denormalized into `CompetitionTime`, `Workout`, and `WorkoutItem` documents to simplify security rules and avoid costly `get()` calls.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces user-ownership for user profiles. Only the authenticated user can manage their profile.
     * @path /users/{userId}
     * @allow (create) - Authenticated user with UID 'user123' can create a profile with id: 'user123'.
     * @allow (get, update, delete) - Authenticated user with UID 'user123' can access their profile at /users/user123.
     * @deny (create) - Authenticated user with UID 'user456' cannot create a profile with id: 'user123'.
     * @deny (get, update, delete) - Authenticated user with UID 'user456' cannot access the profile at /users/user123.
     * @principle Enforces document ownership for all write operations.
     */
    match /users/{userId} {
      // isOwner(userId) - Authenticates if the request is from the owner
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      // isExistingOwner(userId) - Authenticates if the request is from the owner and the resource exists.
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Enforces user-ownership for competition times. Only the authenticated user can manage their competition times.
     * @path /users/{userProfileId}/competitionTimes/{competitionTimeId}
     * @allow (create) - Authenticated user with UID 'user123' can create a competition time under /users/user123/competitionTimes.
     * @allow (get, list, update, delete) - Authenticated user with UID 'user123' can manage their competition times under /users/user123/competitionTimes.
     * @deny (create) - Authenticated user with UID 'user456' cannot create a competition time under /users/user123/competitionTimes.
     * @deny (get, list, update, delete) - Authenticated user with UID 'user456' cannot manage competition times under /users/user123/competitionTimes.
     * @principle Enforces document ownership for all write operations.
     */
    match /users/{userProfileId}/competitionTimes/{competitionTimeId} {
      // isOwner(userProfileId) - Authenticates if the request is from the owner
      function isOwner(userProfileId) {
        return request.auth != null && request.auth.uid == userProfileId;
      }
      // isExistingOwner(userProfileId) - Authenticates if the request is from the owner and the resource exists.
      function isExistingOwner(userProfileId) {
        return isOwner(userProfileId) && resource != null;
      }

      allow get: if isOwner(userProfileId);
      allow list: if isOwner(userProfileId);
      allow create: if isOwner(userProfileId) && request.resource.data.userProfileId == userProfileId;
      allow update: if isExistingOwner(userProfileId) && request.resource.data.userProfileId == resource.data.userProfileId;
      allow delete: if isExistingOwner(userProfileId);
    }

    /**
     * @description Enforces user-ownership for workouts. Only the authenticated user can manage their workouts.
     * @path /users/{userProfileId}/workouts/{workoutId}
     * @allow (create) - Authenticated user with UID 'user123' can create a workout under /users/user123/workouts.
     * @allow (get, list, update, delete) - Authenticated user with UID 'user123' can manage their workouts under /users/user123/workouts.
     * @deny (create) - Authenticated user with UID 'user456' cannot create a workout under /users/user123/workouts.
     * @deny (get, list, update, delete) - Authenticated user with UID 'user456' cannot manage workouts under /users/user123/workouts.
     * @principle Enforces document ownership for all write operations.
     */
    match /users/{userProfileId}/workouts/{workoutId} {
      // isOwner(userProfileId) - Authenticates if the request is from the owner
      function isOwner(userProfileId) {
        return request.auth != null && request.auth.uid == userProfileId;
      }
      // isExistingOwner(userProfileId) - Authenticates if the request is from the owner and the resource exists.
      function isExistingOwner(userProfileId) {
        return isOwner(userProfileId) && resource != null;
      }

      allow get: if isOwner(userProfileId);
      allow list: if isOwner(userProfileId);
      allow create: if isOwner(userProfileId) && request.resource.data.userProfileId == userProfileId;
      allow update: if isExistingOwner(userProfileId) && request.resource.data.userProfileId == resource.data.userProfileId;
      allow delete: if isExistingOwner(userProfileId);
    }

    /**
     * @description Enforces user-ownership for workout items. Only the authenticated user can manage workout items in their workouts.
     * @path /users/{userProfileId}/workouts/{workoutId}/workoutItems/{workoutItemId}
     * @allow (create) - Authenticated user with UID 'user123' can create a workout item under /users/user123/workouts/{workoutId}/workoutItems.
     * @allow (get, list, update, delete) - Authenticated user with UID 'user123' can manage their workout items under /users/user123/workouts/{workoutId}/workoutItems.
     * @deny (create) - Authenticated user with UID 'user456' cannot create a workout item under /users/user123/workouts/{workoutId}/workoutItems.
     * @deny (get, list, update, delete) - Authenticated user with UID 'user456' cannot manage workout items under /users/user123/workouts/{workoutId}/workoutItems.
     * @principle Enforces document ownership for all write operations.
     */
    match /users/{userProfileId}/workouts/{workoutId}/workoutItems/{workoutItemId} {
      // isOwner(userProfileId) - Authenticates if the request is from the owner
      function isOwner(userProfileId) {
        return request.auth != null && request.auth.uid == userProfileId;
      }
      // isExistingOwner(userProfileId) - Authenticates if the request is from the owner and the resource exists.
      function isExistingOwner(userProfileId) {
        return isOwner(userProfileId) && resource != null;
      }

      allow get: if isOwner(userProfileId);
      allow list: if isOwner(userProfileId);
      allow create: if isOwner(userProfileId);
      allow update: if isExistingOwner(userProfileId);
      allow delete: if isExistingOwner(userProfileId);
    }

    /**
     * @description Allows public read access to events. Any user can read event data.
     * @path /events/{eventId}
     * @allow (get, list) - Any user (authenticated or not) can retrieve event data.
     * @deny (create, update, delete) - No user can create, update, or delete events (writes are disabled).
     * @principle Provides public read access while restricting write access.
     */
    match /events/{eventId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}