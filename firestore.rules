rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create) User with UID 'userId' creates their own profile.
     * @deny (create) User with UID 'otherUserId' attempts to create a profile for 'userId'.
     * @allow (get, update, delete) User with UID 'userId' reads/updates/deletes their own profile.
     * @deny (get, update, delete) User with UID 'otherUserId' attempts to read/update/delete the profile of 'userId'.
     * @principle Enforces document ownership and self-creation for user profiles.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && existsAfter(resource);
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false; // Disallowing listing of all user profiles for privacy.
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Controls access to competition time documents for a specific user.
     * @path /users/{userProfileId}/competitionTimes/{competitionTimeId}
     * @allow (create) User with UID 'userProfileId' creates a competition time.
     * @deny (create) User with UID 'otherUserId' attempts to create a competition time for 'userProfileId'.
     * @allow (get, list, update, delete) User with UID 'userProfileId' reads/updates/deletes their own competition time.
     * @deny (get, list, update, delete) User with UID 'otherUserId' attempts to read/update/delete the competition time of 'userProfileId'.
     * @principle Enforces document ownership for competition times.
     */
    match /users/{userProfileId}/competitionTimes/{competitionTimeId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userProfileId) {
        return request.auth.uid == userProfileId;
      }

      function isExistingOwner(userProfileId) {
        return isOwner(userProfileId) && existsAfter(resource);
      }

      allow get: if isSignedIn() && isOwner(userProfileId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userProfileId);
      allow update: if isSignedIn() && isExistingOwner(userProfileId);
      allow delete: if isSignedIn() && isExistingOwner(userProfileId);
    }

    /**
     * @description Controls access to workout documents for a specific user.
     * @path /users/{userProfileId}/workouts/{workoutId}
     * @allow (create) User with UID 'userProfileId' creates a workout.
     * @deny (create) User with UID 'otherUserId' attempts to create a workout for 'userProfileId'.
     * @allow (get, list, update, delete) User with UID 'userProfileId' reads/updates/deletes their own workout.
     * @deny (get, list, update, delete) User with UID 'otherUserId' attempts to read/update/delete the workout of 'userProfileId'.
     * @principle Enforces document ownership for workouts.
     */
    match /users/{userProfileId}/workouts/{workoutId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userProfileId) {
        return request.auth.uid == userProfileId;
      }

      function isExistingOwner(userProfileId) {
        return isOwner(userProfileId) && existsAfter(resource);
      }

      allow get: if isSignedIn() && isOwner(userProfileId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userProfileId);
      allow update: if isSignedIn() && isExistingOwner(userProfileId);
      allow delete: if isSignedIn() && isExistingOwner(userProfileId);
    }

    /**
     * @description Controls access to workout item documents for a specific workout and user.
     * @path /users/{userProfileId}/workouts/{workoutId}/workoutItems/{workoutItemId}
     * @allow (create) User with UID 'userProfileId' creates a workout item within their workout.
     * @deny (create) User with UID 'otherUserId' attempts to create a workout item for 'userProfileId'.
     * @allow (get, list, update, delete) User with UID 'userProfileId' reads/updates/deletes their own workout item.
     * @deny (get, list, update, delete) User with UID 'otherUserId' attempts to read/update/delete the workout item of 'userProfileId'.
     * @principle Enforces document ownership for workout items.
     */
    match /users/{userProfileId}/workouts/{workoutId}/workoutItems/{workoutItemId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userProfileId) {
        return request.auth.uid == userProfileId;
      }

      function isExistingOwner(userProfileId) {
        return isOwner(userProfileId) && existsAfter(resource);
      }

      allow get: if isSignedIn() && isOwner(userProfileId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userProfileId);
      allow update: if isSignedIn() && isExistingOwner(userProfileId);
      allow delete: if isSignedIn() && isExistingOwner(userProfileId);
    }

    /**
     * @description Controls access to event documents. Events are globally readable.
     * @path /events/{eventId}
     * @allow (get, list) Any user (signed in or not) can read event data.
     * @deny (create, update, delete) No user can create, update, or delete events (admin-only via backend).
     * @principle Allows public read access for global event data while restricting write access.
     */
    match /events/{eventId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}