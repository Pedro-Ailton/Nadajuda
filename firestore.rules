/**
 * @fileoverview Firestore Security Rules for NadAjuda application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles, competition times, workouts, and workout items.
 * Events are considered global and accessible to all users.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles. `userId` must match the Firebase Auth UID.
 * - /users/{userProfileId}/competitionTimes/{competitionTimeId}: Stores competition times for each user.
 * - /users/{userProfileId}/workouts/{workoutId}: Stores workouts created by each user.
 * - /users/{userProfileId}/workouts/{workoutId}/workoutItems/{workoutItemId}: Stores workout items for each workout.
 * - /events/{eventId}: Stores global event data.
 *
 * Key Security Decisions:
 * - User data is private and accessible only to the authenticated user.
 * - Events are public and accessible to all users.
 * - Data consistency is enforced by validating the user ID in the path against the document's internal `userProfileId` field on create.
 * - List operations are allowed for owners on their respective subcollections.
 *
 * Denormalization for Authorization:
 * The `userProfileId` is denormalized into all subcollections under `/users/{userProfileId}` to enable simple and secure rules
 * without requiring complex `get()` calls. For example, the `CompetitionTime`, `Workout`, and `WorkoutItem` documents all
 * include a `userProfileId` field.
 *
 * Structural Segregation:
 * Private user data (profiles, competition times, workouts) is stored under the `/users/{userId}` path, while public
 * event data is stored in the top-level `/events` collection. This segregation simplifies access control and ensures that
 * list operations are secure.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure user profiles, ensuring only the owner can read and write their own profile.
     * @path /users/{userId}
     * @allow (create) User with UID 'user_abc' can create their profile at /users/user_abc if request.auth.uid == 'user_abc'.
     * @allow (get) User with UID 'user_abc' can read their profile at /users/user_abc.
     * @allow (update) User with UID 'user_abc' can update their profile at /users/user_abc.
     * @allow (delete) User with UID 'user_abc' can delete their profile at /users/user_abc.
     * @deny (create) User with UID 'user_xyz' cannot create a profile at /users/user_abc.
     * @principle Enforces document ownership for all operations on user profiles.
     */
    match /users/{userId} {
      // Helper function to check if the user is signed in and owns the resource.
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secure competition times, ensuring only the owner can read and write their own competition times.
     * @path /users/{userProfileId}/competitionTimes/{competitionTimeId}
     * @allow (create) User with UID 'user_abc' can create a competition time at /users/user_abc/competitionTimes/comp_123 if request.auth.uid == 'user_abc'.
     * @allow (get) User with UID 'user_abc' can read their competition time at /users/user_abc/competitionTimes/comp_123.
     * @allow (update) User with UID 'user_abc' can update their competition time at /users/user_abc/competitionTimes/comp_123.
     * @allow (delete) User with UID 'user_abc' can delete their competition time at /users/user_abc/competitionTimes/comp_123.
     * @deny (create) User with UID 'user_xyz' cannot create a competition time at /users/user_abc/competitionTimes/comp_123.
     * @principle Enforces document ownership for all operations on competition times.
     */
    match /users/{userProfileId}/competitionTimes/{competitionTimeId} {
      // Helper function to check if the user is signed in and owns the resource.
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userProfileId) {
        return isSignedIn() && request.auth.uid == userProfileId;
      }
      function isExistingOwner(userProfileId) {
        return isOwner(userProfileId) && resource != null;
      }

      allow get: if isOwner(userProfileId);
      allow list: if isOwner(userProfileId);
      allow create: if isOwner(userProfileId);
      allow update: if isExistingOwner(userProfileId);
      allow delete: if isExistingOwner(userProfileId);
    }

    /**
     * @description Secure workouts, ensuring only the owner can read and write their own workouts.
     * @path /users/{userProfileId}/workouts/{workoutId}
     * @allow (create) User with UID 'user_abc' can create a workout at /users/user_abc/workouts/workout_123 if request.auth.uid == 'user_abc'.
     * @allow (get) User with UID 'user_abc' can read their workout at /users/user_abc/workouts/workout_123.
     * @allow (update) User with UID 'user_abc' can update their workout at /users/user_abc/workouts/workout_123.
     * @allow (delete) User with UID 'user_abc' can delete their workout at /users/user_abc/workouts/workout_123.
     * @deny (create) User with UID 'user_xyz' cannot create a workout at /users/user_abc/workouts/workout_123.
     * @principle Enforces document ownership for all operations on workouts.
     */
    match /users/{userProfileId}/workouts/{workoutId} {
      // Helper function to check if the user is signed in and owns the resource.
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userProfileId) {
        return isSignedIn() && request.auth.uid == userProfileId;
      }
      function isExistingOwner(userProfileId) {
        return isOwner(userProfileId) && resource != null;
      }

      allow get: if isOwner(userProfileId);
      allow list: if isOwner(userProfileId);
      allow create: if isOwner(userProfileId);
      allow update: if isExistingOwner(userProfileId);
      allow delete: if isExistingOwner(userProfileId);
    }

    /**
     * @description Secure workout items, ensuring only the owner can read and write their own workout items.
     * @path /users/{userProfileId}/workouts/{workoutId}/workoutItems/{workoutItemId}
     * @allow (create) User with UID 'user_abc' can create a workout item at /users/user_abc/workouts/workout_123/workoutItems/item_456 if request.auth.uid == 'user_abc'.
     * @allow (get) User with UID 'user_abc' can read their workout item at /users/user_abc/workouts/workout_123/workoutItems/item_456.
     * @allow (update) User with UID 'user_abc' can update their workout item at /users/user_abc/workouts/workout_123/workoutItems/item_456.
     * @allow (delete) User with UID 'user_abc' can delete their workout item at /users/user_abc/workouts/workout_123/workoutItems/item_456.
     * @deny (create) User with UID 'user_xyz' cannot create a workout item at /users/user_abc/workouts/workout_123/workoutItems/item_456.
     * @principle Enforces document ownership for all operations on workout items.
     */
    match /users/{userProfileId}/workouts/{workoutId}/workoutItems/{workoutItemId} {
      // Helper function to check if the user is signed in and owns the resource.
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userProfileId) {
        return isSignedIn() && request.auth.uid == userProfileId;
      }
      function isExistingOwner(userProfileId) {
        return isOwner(userProfileId) && resource != null;
      }

      allow get: if isOwner(userProfileId);
      allow list: if isOwner(userProfileId);
      allow create: if isOwner(userProfileId);
      allow update: if isExistingOwner(userProfileId);
      allow delete: if isExistingOwner(userProfileId);
    }

    /**
     * @description Allow public read access to events, but restrict write access.
     * @path /events/{eventId}
     * @allow (get) Any user can read an event at /events/event_123.
     * @allow (list) Any user can list events in the /events collection.
     * @deny (create) No one can create an event at /events/event_123 without custom logic.
     * @deny (update) No one can update an event at /events/event_123 without custom logic.
     * @deny (delete) No one can delete an event at /events/event_123 without custom logic.
     * @principle Events are globally accessible for reading, but writes are disabled.
     */
    match /events/{eventId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}