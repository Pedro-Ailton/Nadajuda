/**
 * @fileoverview Firestore Security Rules for NadAjuda application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles, competition times, workouts, and workout items.
 * Events are considered public and accessible to all users.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles.
 * - /users/{userProfileId}/competitionTimes/{competitionTimeId}: Stores competition times for each user.
 * - /users/{userProfileId}/workouts/{workoutId}: Stores workouts created by each user.
 * - /users/{userProfileId}/workouts/{workoutId}/workoutItems/{workoutItemId}: Stores workout items for each workout.
 * - /events/{eventId}: Stores events, which are considered public.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - All writes under /users/{userId} are restricted to the user identified by {userId}.
 * - Events are publicly readable.
 *
 * Denormalization for Authorization:
 * The 'userProfileId' is denormalized in all subcollections (competitionTimes, workouts, workoutItems) to avoid costly `get()` calls and enforce ownership directly within the subcollection documents.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure user profiles. Only the owner can read/write their own profile.
     * @path /users/{userId}
     * @allow (create) User 'IFdZ3HDwveaM3k9Ky8LZMgtIuC13' can create a profile with id 'IFdZ3HDwveaM3k9Ky8LZMgtIuC13'.
     * @allow (get) User 'IFdZ3HDwveaM3k9Ky8LZMgtIuC13' can read their own profile.
     * @allow (update) User 'IFdZ3HDwveaM3k9Ky8LZMgtIuC13' can update their own profile.
     * @allow (delete) User 'IFdZ3HDwveaM3k9Ky8LZMgtIuC13' can delete their own profile.
     * @deny (create) User 'IFdZ3HDwveaM3k9Ky8LZMgtIuC13' cannot create a profile with id 'someoneElseId'.
     * @deny (get) User 'IFdZ3HDwveaM3k9Ky8LZMgtIuC13' cannot read profile 'someoneElseId'.
     * @deny (update) User 'IFdZ3HDwveaM3k9Ky8LZMgtIuC13' cannot update profile 'someoneElseId'.
     * @deny (delete) User 'IFdZ3HDwveaM3k9Ky8LZMgtIuC13' cannot delete profile 'someoneElseId'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secure competition times. Only the owner can read/write their own competition times.
     * @path /users/{userProfileId}/competitionTimes/{competitionTimeId}
     * @allow (create) User 'IFdZ3HDwveaM3k9Ky8LZMgtIuC13' can create a competition time under their profile.
     * @allow (get) User 'IFdZ3HDwveaM3k9Ky8LZMgtIuC13' can read a competition time under their profile.
     * @allow (update) User 'IFdZ3HDwveaM3k9Ky8LZMgtIuC13' can update a competition time under their profile.
     * @allow (delete) User 'IFdZ3HDwveaM3k9Ky8LZMgtIuC13' can delete a competition time under their profile.
     * @deny (create) User 'someoneElseId' cannot create a competition time under user 'IFdZ3HDwveaM3k9Ky8LZMgtIuC13' profile.
     * @deny (get) User 'someoneElseId' cannot read a competition time under user 'IFdZ3HDwveaM3k9Ky8LZMgtIuC13' profile.
     * @deny (update) User 'someoneElseId' cannot update a competition time under user 'IFdZ3HDwveaM3k9Ky8LZMgtIuC13' profile.
     * @deny (delete) User 'someoneElseId' cannot delete a competition time under user 'IFdZ3HDwveaM3k9Ky8LZMgtIuC13' profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userProfileId}/competitionTimes/{competitionTimeId} {
      allow get: if isOwner(userProfileId);
      allow list: if isOwner(userProfileId);
      allow create: if isOwner(userProfileId) && request.resource.data.userProfileId == userProfileId;
      allow update: if isExistingOwner(userProfileId) && request.resource.data.userProfileId == resource.data.userProfileId;
      allow delete: if isExistingOwner(userProfileId);
    }

    /**
     * @description Secure workouts. Only the owner can read/write their own workouts.
     * @path /users/{userProfileId}/workouts/{workoutId}
     * @allow (create) User 'IFdZ3HDwveaM3k9Ky8LZMgtIuC13' can create a workout under their profile.
     * @allow (get) User 'IFdZ3HDwveaM3k9Ky8LZMgtIuC13' can read a workout under their profile.
     * @allow (update) User 'IFdZ3HDwveaM3k9Ky8LZMgtIuC13' can update a workout under their profile.
     * @allow (delete) User 'IFdZ3HDwveaM3k9Ky8LZMgtIuC13' can delete a workout under their profile.
     * @deny (create) User 'someoneElseId' cannot create a workout under user 'IFdZ3HDwveaM3k9Ky8LZMgtIuC13' profile.
     * @deny (get) User 'someoneElseId' cannot read a workout under user 'IFdZ3HDwveaM3k9Ky8LZMgtIuC13' profile.
     * @deny (update) User 'someoneElseId' cannot update a workout under user 'IFdZ3HDwveaM3k9Ky8LZMgtIuC13' profile.
     * @deny (delete) User 'someoneElseId' cannot delete a workout under user 'IFdZ3HDwveaM3k9Ky8LZMgtIuC13' profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userProfileId}/workouts/{workoutId} {
      allow get: if isOwner(userProfileId);
      allow list: if isOwner(userProfileId);
      allow create: if isOwner(userProfileId) && request.resource.data.userProfileId == userProfileId;
      allow update: if isExistingOwner(userProfileId) && request.resource.data.userProfileId == resource.data.userProfileId;
      allow delete: if isExistingOwner(userProfileId);
    }

    /**
     * @description Secure workout items. Only the owner can read/write their own workout items.
     * @path /users/{userProfileId}/workouts/{workoutId}/workoutItems/{workoutItemId}
     * @allow (create) User 'IFdZ3HDwveaM3k9Ky8LZMgtIuC13' can create a workout item under their workout.
     * @allow (get) User 'IFdZ3HDwveaM3k9Ky8LZMgtIuC13' can read a workout item under their workout.
     * @allow (update) User 'IFdZ3HDwveaM3k9Ky8LZMgtIuC13' can update a workout item under their workout.
     * @allow (delete) User 'IFdZ3HDwveaM3k9Ky8LZMgtIuC13' can delete a workout item under their workout.
     * @deny (create) User 'someoneElseId' cannot create a workout item under user 'IFdZ3HDwveaM3k9Ky8LZMgtIuC13' workout.
     * @deny (get) User 'someoneElseId' cannot read a workout item under user 'IFdZ3HDwveaM3k9Ky8LZMgtIuC13' workout.
     * @deny (update) User 'someoneElseId' cannot update a workout item under user 'IFdZ3HDwveaM3k9Ky8LZMgtIuC13' workout.
     * @deny (delete) User 'someoneElseId' cannot delete a workout item under user 'IFdZ3HDwveaM3k9Ky8LZMgtIuC13' workout.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userProfileId}/workouts/{workoutId}/workoutItems/{workoutItemId} {
      allow get: if isOwner(userProfileId);
      allow list: if isOwner(userProfileId);
      allow create: if isOwner(userProfileId);
      allow update: if isExistingOwner(userProfileId);
      allow delete: if isExistingOwner(userProfileId);
    }

    /**
     * @description Allow public read access to events.
     * @path /events/{eventId}
     * @allow (get) Any user can read events.
     * @allow (list) Any user can list events.
     * @principle Events are considered public data.
     */
    match /events/{eventId} {
      allow get: if true;
      allow list: if true;
      allow create: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return isSignedIn() && request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }
}