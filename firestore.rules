/**
 * @fileoverview Firestore Security Rules for NadAjuda application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles, competition times, workouts, and workout items.
 * Events are considered public and accessible to all users.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles. `userId` must match the Firebase Auth UID.
 * - /users/{userProfileId}/competitionTimes/{competitionTimeId}: Stores competition times for a user. `userProfileId` must match the Firebase Auth UID.
 * - /users/{userProfileId}/workouts/{workoutId}: Stores workouts created by a user. `userProfileId` must match the Firebase Auth UID.
 * - /users/{userProfileId}/workouts/{workoutId}/workoutItems/{workoutItemId}: Stores workout items for a workout. `userProfileId` must match the Firebase Auth UID.
 * - /events/{eventId}: Stores events, accessible to all users.
 *
 * Key Security Decisions:
 * - User profiles and associated data (competition times, workouts, workout items) are strictly owned by the user.
 * - Events are public and readable by all.
 * - List operations on user-owned subcollections are allowed only for the owner.
 *
 * Denormalization for Authorization:
 * - The `userProfileId` is denormalized in the `competitionTimes`, `workouts`, and `workoutItems` collections to allow for simple, path-based authorization rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secures the user profiles collection.
     * @path /users/{userId}
     * @allow (create) User with UID 'user123' creates a profile with ID 'user123'.
     * @deny (create) User with UID 'user456' tries to create a profile with ID 'user123'.
     * @allow (get) User with UID 'user123' reads their own profile.
     * @deny (get) User with UID 'user456' tries to read profile 'user123'.
     * @deny (update) User attempts to modify a profile they don't own.
     * @deny (delete) User attempts to delete a profile they don't own.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secures the competition times subcollection under a user's profile.
     * @path /users/{userProfileId}/competitionTimes/{competitionTimeId}
     * @allow (create) User with UID 'user123' creates a competition time entry under their profile.
     * @deny (create) User with UID 'user456' tries to create a competition time entry under profile 'user123'.
     * @allow (get) User with UID 'user123' reads a competition time entry under their profile.
     * @deny (get) User with UID 'user456' tries to read a competition time entry under profile 'user123'.
     * @deny (update) User attempts to modify a competition time they don't own.
     * @deny (delete) User attempts to delete a competition time they don't own.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userProfileId}/competitionTimes/{competitionTimeId} {
      function isOwner(userProfileId) {
        return request.auth != null && request.auth.uid == userProfileId;
      }

      function isExistingOwner(userProfileId) {
        return isOwner(userProfileId) && resource != null;
      }

      allow get: if isOwner(userProfileId);
      allow list: if isOwner(userProfileId);
      allow create: if isOwner(userProfileId) && request.resource.data.userProfileId == userProfileId;
      allow update: if isExistingOwner(userProfileId) && request.resource.data.userProfileId == resource.data.userProfileId;
      allow delete: if isExistingOwner(userProfileId);
    }

    /**
     * @description Secures the workouts subcollection under a user's profile.
     * @path /users/{userProfileId}/workouts/{workoutId}
     * @allow (create) User with UID 'user123' creates a workout under their profile.
     * @deny (create) User with UID 'user456' tries to create a workout under profile 'user123'.
     * @allow (get) User with UID 'user123' reads a workout under their profile.
     * @deny (get) User with UID 'user456' tries to read a workout under profile 'user123'.
     * @deny (update) User attempts to modify a workout they don't own.
     * @deny (delete) User attempts to delete a workout they don't own.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userProfileId}/workouts/{workoutId} {
      function isOwner(userProfileId) {
        return request.auth != null && request.auth.uid == userProfileId;
      }

      function isExistingOwner(userProfileId) {
        return isOwner(userProfileId) && resource != null;
      }

      allow get: if isOwner(userProfileId);
      allow list: if isOwner(userProfileId);
      allow create: if isOwner(userProfileId) && request.resource.data.userProfileId == userProfileId;
      allow update: if isExistingOwner(userProfileId) && request.resource.data.userProfileId == resource.data.userProfileId;
      allow delete: if isExistingOwner(userProfileId);
    }

    /**
     * @description Secures the workout items subcollection under a workout.
     * @path /users/{userProfileId}/workouts/{workoutId}/workoutItems/{workoutItemId}
     * @allow (create) User with UID 'user123' creates a workout item under their workout.
     * @deny (create) User with UID 'user456' tries to create a workout item under profile 'user123'.
     * @allow (get) User with UID 'user123' reads a workout item under their workout.
     * @deny (get) User with UID 'user456' tries to read a workout item under profile 'user123'.
     * @deny (update) User attempts to modify a workout item they don't own.
     * @deny (delete) User attempts to delete a workout item they don't own.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userProfileId}/workouts/{workoutId}/workoutItems/{workoutItemId} {
      function isOwner(userProfileId) {
        return request.auth != null && request.auth.uid == userProfileId;
      }

      function isExistingOwner(userProfileId) {
        return isOwner(userProfileId) && resource != null;
      }

      allow get: if isOwner(userProfileId);
      allow list: if isOwner(userProfileId);
      allow create: if isOwner(userProfileId) && request.resource.data.workoutId == workoutId;
      allow update: if isExistingOwner(userProfileId);
      allow delete: if isExistingOwner(userProfileId);
    }

    /**
     * @description Secures the events collection. Events are publicly readable.
     * @path /events/{eventId}
     * @allow (get) Any user can read any event.
     * @allow (list) Any user can list events.
     * @deny (create) No one can create events. // TODO: Add owner validation once the schema is updated with an ownership field.
     * @deny (update) No one can update events. // TODO: Add owner validation once the schema is updated with an ownership field.
     * @deny (delete) No one can delete events. // TODO: Add owner validation once the schema is updated with an ownership field.
     * @principle Allows public read access.
     */
    match /events/{eventId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }
  }
}