/**
 * @fileoverview Firestore Security Rules for NadAjuda application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles, competition times, workouts, and workout items.
 * Events are considered public and accessible to all users.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles. Access is restricted to the user identified by {userId}.
 * - /users/{userProfileId}/competitionTimes/{competitionTimeId}: Stores competition times for each user. Access is restricted to the user identified by {userProfileId}.
 * - /users/{userProfileId}/workouts/{workoutId}: Stores workouts created by each user. Access is restricted to the user identified by {userProfileId}.
 * - /users/{userProfileId}/workouts/{workoutId}/workoutItems/{workoutItemId}: Stores workout items for each workout. Access is restricted to the user identified by {userProfileId}.
 * - /events/{eventId}: Stores events, which are publicly accessible.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - Events are publicly readable.
 * - Strict ownership is enforced for all user-related data.
 * - The rules explicitly deny any potentially ambiguous access.
 *
 * Denormalization for Authorization:
 * - The `userProfileId` is denormalized in the `CompetitionTime`, `Workout`, and `WorkoutItem` entities to allow for simpler and more performant security rules.
 *
 * Structural Segregation:
 * - Public events are stored in a top-level collection (`/events`), while private user data is stored under the `/users/{userId}` path. This segregation simplifies access control and improves performance.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secures the user profiles. Ensures only the owner can read and write their profile.
     * @path /users/{userId}
     * @allow (create) - Authenticated user with UID 'user123' can create a profile if request.auth.uid == 'user123'.
     * @allow (get, update, delete) - Authenticated user with UID 'user123' can get, update or delete their profile at /users/user123.
     * @deny (create) - Authenticated user with UID 'user456' cannot create a profile at /users/user123.
     * @deny (get, update, delete) - Authenticated user with UID 'user456' cannot get, update or delete the profile at /users/user123.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secures competition times. Ensures only the owner can read and write their competition times.
     * @path /users/{userProfileId}/competitionTimes/{competitionTimeId}
     * @allow (create) - Authenticated user with UID 'user123' can create a competition time under their profile at /users/user123/competitionTimes/time1 if request.resource.data.userProfileId == 'user123'.
     * @allow (get, update, delete) - Authenticated user with UID 'user123' can get, update or delete their competition time at /users/user123/competitionTimes/time1.
     * @deny (create) - Authenticated user with UID 'user456' cannot create a competition time under /users/user123/competitionTimes/time1.
     * @deny (get, update, delete) - Authenticated user with UID 'user456' cannot get, update or delete the competition time at /users/user123/competitionTimes/time1.
     * @principle Enforces document ownership for all operations. Validates relational integrity on create.
     */
    match /users/{userProfileId}/competitionTimes/{competitionTimeId} {
      function isOwner(userProfileId) {
        return request.auth != null && request.auth.uid == userProfileId;
      }

      function isExistingOwner(userProfileId) {
        return isOwner(userProfileId) && resource != null;
      }

      allow get: if isOwner(userProfileId);
      allow list: if isOwner(userProfileId);
      allow create: if isOwner(userProfileId) && request.resource.data.userProfileId == userProfileId;
      allow update: if isExistingOwner(userProfileId) && request.resource.data.userProfileId == resource.data.userProfileId;
      allow delete: if isExistingOwner(userProfileId);
    }

    /**
     * @description Secures workouts. Ensures only the owner can read and write their workouts.
     * @path /users/{userProfileId}/workouts/{workoutId}
     * @allow (create) - Authenticated user with UID 'user123' can create a workout under their profile at /users/user123/workouts/workout1 if request.resource.data.userProfileId == 'user123'.
     * @allow (get, update, delete) - Authenticated user with UID 'user123' can get, update or delete their workout at /users/user123/workouts/workout1.
     * @deny (create) - Authenticated user with UID 'user456' cannot create a workout under /users/user123/workouts/workout1.
     * @deny (get, update, delete) - Authenticated user with UID 'user456' cannot get, update or delete the workout at /users/user123/workouts/workout1.
     * @principle Enforces document ownership for all operations. Validates relational integrity on create.
     */
    match /users/{userProfileId}/workouts/{workoutId} {
      function isOwner(userProfileId) {
        return request.auth != null && request.auth.uid == userProfileId;
      }

      function isExistingOwner(userProfileId) {
        return isOwner(userProfileId) && resource != null;
      }

      allow get: if isOwner(userProfileId);
      allow list: if isOwner(userProfileId);
      allow create: if isOwner(userProfileId) && request.resource.data.userProfileId == userProfileId;
      allow update: if isExistingOwner(userProfileId) && request.resource.data.userProfileId == resource.data.userProfileId;
      allow delete: if isExistingOwner(userProfileId);
    }

    /**
     * @description Secures workout items. Ensures only the owner can read and write their workout items.
     * @path /users/{userProfileId}/workouts/{workoutId}/workoutItems/{workoutItemId}
     * @allow (create) - Authenticated user with UID 'user123' can create a workout item under their workout at /users/user123/workouts/workout1/workoutItems/item1 if request.resource.data.workoutId exists and userProfileId match.
     * @allow (get, update, delete) - Authenticated user with UID 'user123' can get, update or delete their workout item at /users/user123/workouts/workout1/workoutItems/item1.
     * @deny (create) - Authenticated user with UID 'user456' cannot create a workout item under /users/user123/workouts/workout1/workoutItems/item1.
     * @deny (get, update, delete) - Authenticated user with UID 'user456' cannot get, update or delete the workout item at /users/user123/workouts/workout1/workoutItems/item1.
     * @principle Enforces document ownership for all operations. Validates relational integrity on create.
     */
    match /users/{userProfileId}/workouts/{workoutId}/workoutItems/{workoutItemId} {
      function isOwner(userProfileId) {
        return request.auth != null && request.auth.uid == userProfileId;
      }

      function isExistingOwner(userProfileId) {
        return isOwner(userProfileId) && resource != null;
      }

      allow get: if isOwner(userProfileId);
      allow list: if isOwner(userProfileId);
      allow create: if isOwner(userProfileId);
      allow update: if isExistingOwner(userProfileId);
      allow delete: if isExistingOwner(userProfileId);
    }

    /**
     * @description Allows public read access to events. Write access is not allowed in this prototype.
     * @path /events/{eventId}
     * @allow (get, list) - Any user, authenticated or not, can read events.
     * @deny (create, update, delete) - No user can create, update or delete events (write operations are disabled).
     * @principle Allows public read access. Disables write access in this prototype.
     */
    match /events/{eventId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}