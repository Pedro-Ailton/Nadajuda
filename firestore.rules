/**
 * @fileoverview Firestore Security Rules for NadAjuda application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles, competition times, workouts, and workout items.
 * Events are considered public and accessible to all users.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles.
 * - /users/{userProfileId}/competitionTimes/{competitionTimeId}: Stores competition times for each user.
 * - /users/{userProfileId}/workouts/{workoutId}: Stores workouts created by each user.
 * - /users/{userProfileId}/workouts/{workoutId}/workoutItems/{workoutItemId}: Stores workout items for each workout.
 * - /events/{eventId}: Stores events, which are considered public.
 *
 * Key Security Decisions:
 * - User profiles and their associated data (competition times, workouts, workout items) are strictly owned by the user, and access is controlled via the `userId` path parameter.
 * - Events are publicly readable.
 * - Data consistency between the path and the document's internal fields is enforced on `create` and `update` operations to prevent unauthorized data manipulation.
 * - List operations are generally allowed for user-owned subcollections, enabling the user to view their own data.
 *
 * Denormalization for Authorization:
 * - The `userProfileId` is denormalized into all subcollections under `/users/{userProfileId}` (competitionTimes, workouts, workoutItems) to simplify authorization rules and avoid costly `get()` calls.
 *
 * Structural Segregation:
 * - Events are stored in a separate top-level collection (`/events`) to allow for public read access without compromising the security of user-specific data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants access to user profiles based on ownership.
     * @path /users/{userId}
     * @allow (create) - Authenticated user with UID 'user_abc' can create their own profile at /users/user_abc.
     * @allow (get, update, delete) - Authenticated user with UID 'user_abc' can get, update, and delete their own profile at /users/user_abc.
     * @deny (create) - Authenticated user with UID 'user_xyz' cannot create a profile at /users/user_abc.
     * @deny (get, update, delete) - Authenticated user with UID 'user_xyz' cannot get, update, or delete the profile at /users/user_abc.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Grants access to competition times based on user ownership.
     * @path /users/{userProfileId}/competitionTimes/{competitionTimeId}
     * @allow (create) - Authenticated user with UID 'user_abc' can create a competition time document under /users/user_abc/competitionTimes/{competitionTimeId}.
     * @allow (get, list, update, delete) - Authenticated user with UID 'user_abc' can get, list, update, and delete their own competition time documents under /users/user_abc/competitionTimes/{competitionTimeId}.
     * @deny (create) - Authenticated user with UID 'user_xyz' cannot create a competition time document under /users/user_abc/competitionTimes/{competitionTimeId}.
     * @deny (get, list, update, delete) - Authenticated user with UID 'user_xyz' cannot get, list, update, or delete competition time documents under /users/user_abc/competitionTimes/{competitionTimeId}.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userProfileId}/competitionTimes/{competitionTimeId} {
      function isOwner(userProfileId) {
        return request.auth != null && request.auth.uid == userProfileId;
      }

      function isExistingOwner(userProfileId) {
        return isOwner(userProfileId) && resource != null;
      }
      allow get: if isOwner(userProfileId);
      allow list: if isOwner(userProfileId);
      allow create: if isOwner(userProfileId) && request.resource.data.userProfileId == userProfileId;
      allow update: if isExistingOwner(userProfileId) && request.resource.data.userProfileId == resource.data.userProfileId;
      allow delete: if isExistingOwner(userProfileId);
    }

    /**
     * @description Grants access to workouts based on user ownership.
     * @path /users/{userProfileId}/workouts/{workoutId}
     * @allow (create) - Authenticated user with UID 'user_abc' can create a workout document under /users/user_abc/workouts/{workoutId}.
     * @allow (get, list, update, delete) - Authenticated user with UID 'user_abc' can get, list, update, and delete their own workout documents under /users/user_abc/workouts/{workoutId}.
     * @deny (create) - Authenticated user with UID 'user_xyz' cannot create a workout document under /users/user_abc/workouts/{workoutId}.
     * @deny (get, list, update, delete) - Authenticated user with UID 'user_xyz' cannot get, list, update, or delete workout documents under /users/user_abc/workouts/{workoutId}.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userProfileId}/workouts/{workoutId} {
      function isOwner(userProfileId) {
        return request.auth != null && request.auth.uid == userProfileId;
      }

      function isExistingOwner(userProfileId) {
        return isOwner(userProfileId) && resource != null;
      }

      allow get: if isOwner(userProfileId);
      allow list: if isOwner(userProfileId);
      allow create: if isOwner(userProfileId) && request.resource.data.userProfileId == userProfileId;
      allow update: if isExistingOwner(userProfileId) && request.resource.data.userProfileId == resource.data.userProfileId;
      allow delete: if isExistingOwner(userProfileId);
    }

    /**
     * @description Grants access to workout items based on user and workout ownership.
     * @path /users/{userProfileId}/workouts/{workoutId}/workoutItems/{workoutItemId}
     * @allow (create) - Authenticated user with UID 'user_abc' can create a workout item document under /users/user_abc/workouts/{workoutId}/workoutItems/{workoutItemId}.
     * @allow (get, list, update, delete) - Authenticated user with UID 'user_abc' can get, list, update, and delete their own workout item documents under /users/user_abc/workouts/{workoutId}/workoutItems/{workoutItemId}.
     * @deny (create) - Authenticated user with UID 'user_xyz' cannot create a workout item document under /users/user_abc/workouts/{workoutId}/workoutItems/{workoutItemId}.
     * @deny (get, list, update, delete) - Authenticated user with UID 'user_xyz' cannot get, list, update, or delete workout item documents under /users/user_abc/workouts/{workoutId}/workoutItems/{workoutItemId}.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userProfileId}/workouts/{workoutId}/workoutItems/{workoutItemId} {
      function isOwner(userProfileId) {
        return request.auth != null && request.auth.uid == userProfileId;
      }

      function isExistingOwner(userProfileId) {
        return isOwner(userProfileId) && resource != null;
      }
      allow get: if isOwner(userProfileId);
      allow list: if isOwner(userProfileId);
      allow create: if isOwner(userProfileId) && request.resource.data.workoutId == workoutId;
      allow update: if isExistingOwner(userProfileId);
      allow delete: if isExistingOwner(userProfileId);
    }

    /**
     * @description Grants public read access to events. Write access is not allowed in this prototype.
     * @path /events/{eventId}
     * @allow (get, list) - Any user (authenticated or not) can get and list events.
     * @deny (create, update, delete) - No user can create, update, or delete events.
     * @principle Allows public read access while restricting write access.
     */
    match /events/{eventId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}